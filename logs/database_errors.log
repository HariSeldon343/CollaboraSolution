        WHEN fa.expires_at IS NULL THEN 0
        WHEN fa.expires_at > NOW() THEN 0
        ELSE 1
    END as is_expired,

    -- Check if expiring soon (within 7 days)
    CASE
        WHEN fa.expires_at IS NULL THEN 0
        WHEN fa.expires_at <= DATE_ADD(NOW(), INTERVAL 7 DAY) AND fa.expires_at > NOW() THEN 1
        ELSE 0
    END as is_expiring_soon

