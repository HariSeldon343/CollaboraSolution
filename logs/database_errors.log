LEFT JOIN folders fo ON fa.folder_id = fo.id
LEFT JOIN users u_to ON fa.assigned_to_user_id = u_to.id
LEFT JOIN users u_by ON fa.assigned_by_user_id = u_by.id
WHERE fa.tenant_id = ?
