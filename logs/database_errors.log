    -- File details
    f.file_name,
    f.file_size,
    f.mime_type,
    f.uploaded_by as file_creator_id,

    -- Folder details
    fo.folder_name,
    fo.created_by as folder_creator_id,

    -- Assigned to user
    u_to.id as assigned_to_id,
    u_to.name as assigned_to_name,
